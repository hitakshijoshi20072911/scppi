# Application Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Process Mode (api or worker)
PROCESS_MODE=api

# Database (to be configured when database is implemented)
# DATABASE_URL=postgresql://user:password@localhost:5432/vendorproof

# Swytchcode (to be configured when Swytchcode is integrated)
# SWYTCHCODE_TOKEN=your_token_here

# Provider Credentials (to be configured when providers are verified)
# STRIPE_SECRET_KEY=sk_test_...
# GITHUB_TOKEN=ghp_...
# GOOGLE_DRIVE_CREDENTIALS=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...

# LLM Configuration (to be configured when LLM provider is selected)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4

# Logging
LOG_LEVEL=info
