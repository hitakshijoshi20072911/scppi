# Application
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PROCESS_MODE=api
API_CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info

# Database
# DATABASE_URL is for local development and reviewed migration execution only.
# Hosted API runtime in staging/production must use the restricted vendorproof_app role.
DATABASE_URL=postgresql://vendorproof:vendorproof@127.0.0.1:5433/vendorproof
# APP_DATABASE_URL is only for staging/production and must use the restricted role.
# APP_DATABASE_URL=postgresql://vendorproof_app:*****@db.example.test:5432/vendorproof

# Swytchcode service token for the official runtime; keep it server-only.
# SWYTCHCODE_TOKEN=your_rotated_service_token_here
