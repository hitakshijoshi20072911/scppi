# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PROCESS_MODE=api
API_CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info

# Database
# DATABASE_URL is for local development and reviewed migration execution only.
# Hosted API runtime in staging/production must use the restricted vendorproof_app role.
# APP_DATABASE_URL=postgresql://vendorproof_app:*****@localhost:5432/vendorproof
# DATABASE_URL=postgresql://migration_user:*****@localhost:5432/vendorproof

# Swytchcode service token for the official runtime; keep it server-only.
# SWYTCHCODE_TOKEN=your_rotated_service_token_here
