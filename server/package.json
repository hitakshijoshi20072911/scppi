{
  "name": "@vendorproof/server",
  "version": "0.0.0",
  "private": true,
  "description": "VendorProof backend API and worker",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:unit": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.0.0",
    "@swytchcode/runtime": "^1.2.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "swytchcode": "^2.25.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
